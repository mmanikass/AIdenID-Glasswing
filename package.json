{
  "name": "aidenid-clearance",
  "version": "0.0.0",
  "private": true,
  "description": "AIdenID Clearance Layer verifier, registry, control plane, and decision stream.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "postcss": "8.5.23",
      "vite": "8.0.16",
      "nanoid": "3.3.18",
      "find-my-way": "9.7.0",
      "next": "15.5.21",
      "sharp": "0.35.0",
      "js-yaml": "4.3.1",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "security:secrets": "node scripts/security-scan.mjs secrets",
    "test": "pnpm build && vitest run --passWithNoTests",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "8.0.16",
    "vitest": "^4.0.8"
  }
}
