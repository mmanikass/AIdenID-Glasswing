# Reference values for local development. `pnpm dev` applies its own loopback,
# ephemeral defaults and does not inherit database, Redis, or credential settings.
# See docs/aidenid-build/LOCAL_DEVELOPMENT.md for the full launcher contract.
NODE_ENV=development

# Launcher ports (all loopback). The three must differ.
AIDENID_DEV_PROTECTED_SITE_PORT=4100
AIDENID_DEV_CONTROL_PLANE_PORT=4000
AIDENID_DEV_DASHBOARD_PORT=3000

# Optional fixed secrets for scripted use (32+ characters each, must differ).
# Leave unset and the launcher generates fresh values per run without printing them.
# AIDENID_DEV_OPERATOR_TOKEN=
# AIDENID_DEV_DASHBOARD_REQUEST_TOKEN=

# Optional model credential for Jev; forwarded to the protected-site process only.
# ANTHROPIC_API_KEY=
# JEV_MODEL=

# Values the launcher derives for the protected-site process.
# HOST=127.0.0.1
# PORT=4100
# AIDENID_CONTROL_PLANE_PORT=4000
# GLASSWING_OPERATOR_TOKEN=<generated>
AIDENID_ALLOW_EPHEMERAL_CONTROL_PLANE_STORE=true
AIDENID_ALLOW_IN_MEMORY_CONTROL_PLANE_OUTBOX=true
AIDENID_ALLOW_EPHEMERAL_DECISION_RECEIPT_KEY=true
AIDENID_CONTROL_PLANE_RUN_MIGRATIONS=false

# Values the launcher derives for the dashboard process.
AIDENID_CONTROL_PLANE_URL=http://127.0.0.1:4000
AIDENID_PROTECTED_SITE_URL=http://127.0.0.1:4100
# AIDENID_OPERATOR_TOKEN=<generated, same value as GLASSWING_OPERATOR_TOKEN>
# AIDENID_DASHBOARD_OPERATOR_REQUEST_TOKEN=<generated, distinct>
AIDENID_DASHBOARD_SITE_ID=sit_glasswing_demo
AIDENID_DASHBOARD_REQUIRE_LIVE_DATA=true
AIDENID_REQUIRE_LOGIN=false
AIDENID_DASHBOARD_DEV_SESSION=true
NEXT_TELEMETRY_DISABLED=1
